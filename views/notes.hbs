<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Notes</title>
</head>
<body>
    
        
        <section class="notes">
            <div class="dataBtn">
                <p>Add Item <span class="key">a</span></p>
            </div>
            
            
            
            <div class="add-form hidden">
                <form action="/add-note" method="POST">
                    <input type="text" name="add-note" id="add-note" placeholder="Add Note">
                    <button class="dataBtn">Add</button>
                </form>
            </div>

            <section class="notes-display">
                <table>
                    <thead>
                        <th></th>
                        <th>Notes</th>
                        <th>Age</th>
                        <th></th>
                    </thead>
                    <tbody>
                        {{#each notes}}
                        {{#if priority}}
                        <tr class="priority-row">
                            <td>
                                <form action="/complete/{{noteID}}" method="POST">
                                    <button class="completeBtn"></button>
                                </form>
                            </td>
                            <td contenteditable="true" spellcheck="false" data-id="{{noteID}}" class="max-width">{{notes}}</td>
                            <td class="dateVisual">
                                <div class="container" data-date="{{dateCreated}}">
                                    {{!-- Simulate time here --}}
                                </div>
                            </td>
                            <td>
                                <form action="/priority/{{noteID}}" method="POST">
                                    <button class="unpriorityBtn"></button>
                                </form>
                            </td>
                        </tr>
                        {{else}}
                        <tr>
                            <td>
                                <form action="/complete/{{noteID}}" method="POST">
                                    <button class="completeBtn"></button>
                                </form>
                            </td>
                            <td contenteditable="true" spellcheck="false" data-id="{{noteID}}" class="max-width">{{notes}}</td>
                            <td class="dateVisual">
                                <div class="container" data-date="{{dateCreated}}">
                                    {{!-- Simulate time here --}}
                                </div>
                            </td>
                            <td>
                                <form action="/priority/{{noteID}}" method="POST">
                                    <button class="priorityBtn"></button>
                                    
                                </form>
                            </td>
                        </tr>
                        {{/if}}
                        {{/each}}
                    </tbody>
                </table>
            </section>
        </section>
    {{!-- <div class="scheduleBtn">
    </div>
    <div class="historyBtn">
    </div>
    <div class="tasksBtn">
    </div> --}}

    
</body>
</html>

<script src="/src/notes.js"></script>