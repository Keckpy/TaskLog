<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Tasks</title>
</head>
<body>
    <div class="historyBtn">
        <a href="/notes"><p>Back <span class="key" >b</span></p></a>
    </div>
    <div class="task-options">
        <div class="dataBtn" id="centaurBtn">
            <p>Centaur <span class="key">c</span></p>
        </div>
        <div class="dataBtn" id="urinesBtn">
            <p>Urines Bench <span class="key">u</span></p>
        </div>
        <div class="dataBtn" id="ancillaryBtn">
            <p>Ancillary <span class="key">a</span></p>
        </div>
        <div class="dataBtn" id="remisolBtn">
            <p>Remisol <span class="key">r</span></p>
        </div>
    </div>
    
    <form action="" class="add-form hidden" id="centaur">
        <h1>Centaur</h1>
        <div class="tasks-list">
            <div class="task">
                <input type="checkbox" name="daily-report" id="setup">
                <label for="setup">Setup/QC</label>
            </div>
            <div class="task">
                <input type="checkbox" name="daily-report" id="rodi">
                <label for="rodi">RODI</label>
            </div>
            <div class="task">
                <input type="checkbox" name="daily-report" id="daily-report">
                <label for="daily-report">Daily Report</label>
            </div>
            <div class="task">
                <input type="checkbox" name="daily-report" id="surgery">
                <label for="surgery">Surgery</label>
            </div>
            <div class="task">
                <input type="checkbox" name="daily-report" id="desk-saves">
                <label for="desk-saves">Desk Saves</label>
            </div>
            <div class="task">
                <input type="checkbox" name="daily-report" id="serology-saves">
                <label for="serology-saves">Serology Saves</label>
            </div>
            <div class="task">
                <input type="checkbox" name="daily-report" id="rpr-saves">
                <label for="rpr-saves">RPR Saves</label>
            </div>
            <div class="task">
                <input type="checkbox" name="daily-report" id="centaur-printouts">
                <label for="centaur-printouts">Centaur Printouts</label>
            </div>
        </div>
    </form>
    <form action="" class="add-form hidden" id="urines-bench">
        <h1>Urines Bench</h1>
        <div class="tasks-list">
            <div class="task">
                <input type="checkbox" name="daily-report" id="setup">
                <label for="setup">Setup/QC</label>
            </div>
            <div class="task">
                <input type="checkbox" name="daily-report" id="rodi">
                <label for="rodi">RODI</label>
            </div>
            <div class="task">
                <input type="checkbox" name="daily-report" id="dxi2">
                <label for="dxi2">DXI 2 Setup</label>
            </div>
            <div class="task">
                <input type="checkbox" name="daily-report" id="pep">
                <label for="pep">PEP</label>
            </div>
            <div class="task">
                <input type="checkbox" name="daily-report" id="desk-saves">
                <label for="desk-saves">Desk Saves</label>
            </div>
            <div class="task">
                <input type="checkbox" name="daily-report" id="serology-saves">
                <label for="serology-saves">Serology Saves</label>
            </div>
            <div class="task">
                <input type="checkbox" name="daily-report" id="rpr-saves">
                <label for="rpr-saves">RPR Saves</label>
            </div>
            <div class="task">
                <input type="checkbox" name="daily-report" id="ana">
                <label for="ana">ANA</label>
            </div>
        </div>
    </form>
    <form action="" class="add-form hidden" id="ancillary">
        <h1>Ancillary</h1>
        <div class="tasks-list">
            <div class="task">
                <input type="checkbox" name="daily-report" id="rodi">
                <label for="rodi">RODI</label>
            </div>
            <div class="task">
                <input type="checkbox" name="daily-report" id="ana">
                <label for="ana">ANA</label>
            </div>
            <div class="task">
                <input type="checkbox" name="daily-report" id="pep">
                <label for="pep">PEP</label>
            </div>
            <div class="task">
                <input type="checkbox" name="daily-report" id="desk-saves">
                <label for="desk-saves">Desk Saves</label>
            </div>
            <div class="task">
                <input type="checkbox" name="daily-report" id="serology-saves">
                <label for="serology-saves">Serology Saves</label>
            </div>
            <div class="task">
                <input type="checkbox" name="daily-report" id="rpr-saves">
                <label for="rpr-saves">RPR Saves</label>
            </div>
            <div class="task">
                <input type="checkbox" name="daily-report" id="rpr">
                <label for="rpr">RPR</label>
            </div>
        </div>
    </form>
    <form action="" class="add-form hidden" id="remisol">
        <h1>Remisol</h1>
        <div class="tasks-list">
            <div class="task">
                <input type="checkbox" name="daily-report" id="rodi">
                <label for="rodi">RODI</label>
            </div>
            <div class="task">
                <input type="checkbox" name="daily-report" id="dxi2">
                <label for="dxi2">DXI 2 Setup</label>
            </div>
            <div class="task">
                <input type="checkbox" name="daily-report" id="desk-saves">
                <label for="desk-saves">Desk Saves</label>
            </div>
            <div class="task">
                <input type="checkbox" name="daily-report" id="serology-saves">
                <label for="serology-saves">Serology Saves</label>
            </div>
            <div class="task">
                <input type="checkbox" name="daily-report" id="rpr-saves">
                <label for="rpr-saves">RPR Saves</label>
            </div>
        </div>
    </form>
    
    <div class="add-form">
        <form action="/add-task" method="POST">
            <input type="text" name="add-task" id="add-task" placeholder="Add Task [t]">
            <button class="dataBtn">Add</button>
        </form>
    </div>
    <section class="notes-display">
        <table>
            <thead>
                <th></th>
                <th>Tasks</th>
                <th></th>
            </thead>
            <tbody>
                {{#each tasks}}
                <tr>
                    <td>
                        <button class="completeBtn" id="visual" data-id="{{taskID}}"></button>
                    </td>
                    <td contenteditable="true" spellcheck="false" data-id="{{taskID}}" class="max-width">{{task}}</td>
                    <td>
                        <form action="/tasks/delete/{{taskID}}" method="POST">
                            <button class="deleteBtn">
                                <svg viewBox="0 0 24 24" width="20" height="20" fill="none"
                                    stroke="currentColor" stroke-width="2"
                                    stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M3 6h18"></path>
                                    <path d="M8 6V4h8v2"></path>
                                    <path d="M19 6l-1 14H6L5 6"></path>
                                    <path d="M10 11v5"></path>
                                    <path d="M14 11v5"></path>
                                </svg>
                            </button>
                        </form>
                    </td>
                </tr>
                {{/each}}
            </tbody>
        </table>
    </section>
</body>
</html>

<script src="/src/tasks.js"></script>